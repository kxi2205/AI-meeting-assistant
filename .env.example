# =============================================================================
# AI MEETING ASSISTANT - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# REQUIRED SETTINGS
# -----------------

# Groq API Key (FREE)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection String
# Get from MongoDB Atlas: https://mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=meeting_assistant


# OPTIONAL SETTINGS
# -----------------

# Whisper Configuration
# Options: tiny, base, small, medium, large, large-v3
# Recommendation: base (fast) or medium (accurate)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu  # or cuda if you have GPU

# Groq Configuration
# Models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2000


# INTEGRATIONS (Optional)
# -----------------------

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C01234567

# Email Integration
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_app_password


# ADVANCED SETTINGS (Optional)
# ----------------------------

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Audio Processing
MAX_AUDIO_SIZE_MB=100

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
